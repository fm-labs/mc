#}

# --- helpers ---------------------------------------------------------------
is_private_key() {
    # OpenSSH, RSA/EC/DSA PEM and PKCS#8 keys all start with a
    # "-----BEGIN ... PRIVATE KEY-----" line.
    [[ -f $1 && -r $1 ]] && head -n 1 "$1" 2>/dev/null | grep -q -- '-----BEGIN .*PRIVATE KEY-----'
}

fingerprint() {
    # Prefer the .pub file; fall back to the private key (works for
    # OpenSSH-format keys without the passphrase).
    local key=$1 src=$1
    [[ -r $key.pub ]] && src=$key.pub
    ssh-keygen -l -f "$src" 2>/dev/null | awk '{print $2}'
}

# --- main ------------------------------------------------------------------
if [[ -z ${SSH_AUTH_SOCK:-} ]]; then
    echo "error: no ssh-agent running (SSH_AUTH_SOCK unset). Try: eval \"\$(ssh-agent)\"" >&2
    exit 1
fi
[[ -d $SSH_DIR ]] || { echo "error: not a directory: $SSH_DIR" >&2; exit 1; }

loaded=$(ssh-add -l 2>/dev/null | awk '{print $2}')
added=0 skipped=0 failed=0

shopt -s nullglob
for key in "$SSH_DIR"/*; do
    [[ $key == *.pub ]] && continue
    is_private_key "$key" || continue

    name=$(basename "$key")
    fp=$(fingerprint "$key")
    #if [[ -n $fp ]] && grep -qxF -- "$fp" <<< "$loaded"; then
    #    echo "skip   $name (already loaded)"
    #    ((skipped++))
    #    continue
    #fi

    pwfile=$PW_DIR/$name
    if [[ -f $pwfile ]]; then
        echo "add    $name (password file)"
        ssh-add-enc "$key" "$pwfile"
    else
        echo "add    $name"
        SSH_ASKPASS=/usr/bin/false \
        SSH_ASKPASS_REQUIRE=force \
        DISPLAY=${DISPLAY:-:0} \
        ssh-add "${EXTRA_OPTS[@]}" "$key"
    fi

    if [[ $? -eq 0 ]]; then
        ((added++))
    else
        echo "FAILED $name" >&2
        ((failed++))
    fi
done

echo "done: $added added, $skipped skipped, $failed failed"
[[ $failed -eq 0 ]]