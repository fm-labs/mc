#        return 2
#    fi
#    local key=$1 pwfile=$2
#    [[ -r $key    ]] || { echo "ssh-add-enc: cannot read key: $key" >&2; return 1; }
#    [[ -r $pwfile ]] || { echo "ssh-add-enc: cannot read password file: $pwfile" >&2; return 1; }
#
#    local askpass
