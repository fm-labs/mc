#!/usr/bin/env bash
# ssh-add-all.sh — load all private keys from an .ssh directory into ssh-agent.
#
# For each private key <dir>/<name>:
#   - if <pwdir>/<name> exists, the passphrase is read from it (via ssh-add-enc)
#   - otherwise plain ssh-add is used (prompts if the key is encrypted)
# Keys already loaded in the agent are skipped.
#
# Usage: ssh-add-all.sh [ssh-dir] [password-dir]
#   ssh-dir       default: ~/.ssh
#   password-dir  default: <ssh-dir>/passwords
# Env:   SSH_ADD_OPTS  extra options for ssh-add, e.g. SSH_ADD_OPTS="-t 3600"

set -u

PATH=$(pwd):$PATH
SSH_DIR=${1:-$HOME/.ssh}
PW_DIR=${2:-$HOME/.sshpass}
read -r -a EXTRA_OPTS <<< "${SSH_ADD_OPTS:-}"

SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-/ssh-agent/agent.sock}
export SSH_AUTH_SOCK

# --- ssh-add with passphrase from file -------------------------------------
